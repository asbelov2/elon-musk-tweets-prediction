# Docker Compose: application port is local; the HTTPS proxy owns 80/443.
TWEETSCOPE_HTTP_PORT=18080
# Leave blank for local development; Compose defaults to http://localhost:18080.
# compose.https.yaml sets https://APP_DOMAIN automatically.
PUBLIC_URL=
# All functions are public, including shared history and catalog changes.
WRITE_ACCESS=public
ADMIN_USERNAME=admin
# Optional: only used if you later choose WRITE_ACCESS=admin. Minimum 16 characters.
ADMIN_PASSWORD=
# XTracker requires no key. Keep these empty unless you need optional API X collection.
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=

# Required only for compose.https.yaml. Put your own DNS name here, without https://.
APP_DOMAIN=
