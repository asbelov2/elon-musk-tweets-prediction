# Add this as a NEW site, replacing tweets.example.com with your own subdomain.
# The existing project's server blocks remain unchanged.
server {
    listen 80;
    listen [::]:80;
    server_name tweets.example.com;

    client_max_body_size 6m;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        # Replace incoming forwarded headers; the app trusts only this proxy hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
